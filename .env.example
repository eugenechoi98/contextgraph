# Default no-model mode
VECTOR_INDEX_ENABLED=false
HYBRID_VECTOR_ENABLED=false

# CodeRankEmbed first download example
# Replace the cache path with your own local folder outside the repo.
# EMBEDDING_PROVIDER=sentence-transformer
# EMBEDDING_MODEL=nomic-ai/CodeRankEmbed
# EMBEDDING_REVISION=3c4b60807d71f79b43f3c4363786d9493691f8b1
# EMBEDDING_DEVICE=cpu
# EMBEDDING_TRUST_REMOTE_CODE=true
# EMBEDDING_LOCAL_FILES_ONLY=false
# EMBEDDING_CACHE_DIR=D:/contextgraph-model-cache
# EMBEDDING_BATCH_SIZE=4

# CodeRankEmbed offline example after the first download
# EMBEDDING_PROVIDER=sentence-transformer
# EMBEDDING_MODEL=nomic-ai/CodeRankEmbed
# EMBEDDING_REVISION=3c4b60807d71f79b43f3c4363786d9493691f8b1
# EMBEDDING_DEVICE=cpu
# EMBEDDING_TRUST_REMOTE_CODE=true
# EMBEDDING_LOCAL_FILES_ONLY=true
# EMBEDDING_CACHE_DIR=D:/contextgraph-model-cache
# EMBEDDING_BATCH_SIZE=4
